  "match": { "remote": "Medivance-dev/yonsei88" },
  "expects": ["app/layout.tsx", "util/style.ts", "hooks/useScale.tsx"],
  "teamBaseline": "",
  "teamDocs": [],
  "protected": [
    { "pattern": "^(hooks|util)/", "reason": "여러 섹션이 같이 쓰는 공통 유틸입니다. 사용하는 곳을 확인했나요?" },
